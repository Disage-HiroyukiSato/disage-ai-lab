# Authentik OIDC provider values
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/application/o/disage-ai/
OAUTH2_PROXY_CLIENT_ID=CHANGE_ME
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_REDIRECT_URL=https://ai.example.com/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_COOKIE_SECURE=true

# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
