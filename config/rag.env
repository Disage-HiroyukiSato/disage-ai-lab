#############################################
# Embedding
#############################################

EMBEDDING_MODEL=/models/embedding/bge-m3
#EMBEDDING_MODEL=intfloat/multilingual-e5-large

#############################################
# Chunk
#############################################

CHUNK_SIZE=500

CHUNK_OVERLAP=100

#############################################
# Retrieval
#############################################

RETRIEVAL_CANDIDATE_SIZE=20

DEFAULT_LIMIT=5

MAX_DISTANCE=0.80

#############################################
# Reranker
#############################################

RERANK_MODEL=/models/reranker/bge-reranker-base

MIN_RERANK_SCORE=0.30

#############################################
# Query Expansion
#############################################

ENABLE_QUERY_EXPANSION=false

EXPANSION_LIMIT=3

#############################################
# Hybrid Search
#############################################

ENABLE_HYBRID_SEARCH=false

BM25_WEIGHT=0.30

VECTOR_WEIGHT=0.70

#############################################
# Search Cache
#############################################

ENABLE_SEARCH_CACHE=false

REDIS_HOST=redis

REDIS_PORT=6379

REDIS_DB=1

CACHE_TTL=300

CACHE_KEY_PREFIX=disage:retrieval:

#############################################
# Phase16 : Collections
#############################################

COLLECTION_JAVA_TRAINING=java_training

COLLECTION_INSTRUCTOR_OPS=instructor_ops

COLLECTION_ROUTER_DICTIONARY=/app/config/collection_router_dictionary.json

#############################################
# Phase17 : 研修用AIアシスタント
#############################################

ENABLE_TRAINING_ASSISTANT=false

# マルチターン対話で遡る往復数
CONVERSATION_HISTORY_TURNS=10

# 現在学習中chapterのブースト強度(0.0で無効化)
CHAPTER_BOOST_WEIGHT=0.15

# 教材外判定用キーワード辞書
OFF_TOPIC_DICTIONARY=/app/config/off_topic_dictionary.json

# PostgreSQL接続(コンテナ間通信用、5432固定)
POSTGRES_PORT_INTERNAL=5432

# Query Rewriting専用LLM（軽量モデル、別コンテナ）
LLM_REWRITER_URL=http://llama-rewriter:8080
LLM_REWRITER_TIMEOUT=30

#############################################
# Parent Retrieval
#############################################

ENABLE_PARENT_DOCUMENT=false

PARENT_CHUNK_SIZE=3

#############################################
# Metadata Search
#############################################

ENABLE_METADATA_SEARCH=false

#############################################
# Prompt
#############################################

MAX_CONTEXT_DOCUMENTS=5

MAX_CONTEXT_LENGTH=6000

#############################################
# ChromaDB
#############################################

CHROMA_HOST=chromadb

CHROMA_PORT=8000

CHROMA_COLLECTION=java_training

#############################################
# Logging
#############################################

LOG_LEVEL=INFO

LOG_PROMPT=false

LOG_SQL=false

#############################################
# Timeout
#############################################

REQUEST_TIMEOUT=30

LLM_TIMEOUT=300

API_TIMEOUT=600

#############################################
# Llama.cpp
#############################################

LLM_URL=http://llama-cpp:8080

LLM_API_URL=http://llama-cpp:8080/v1/chat/completions

LLM_HEALTH_URL=http://llama-cpp:8080/health

TEMPERATURE=0.2

TOP_P=0.95

REPEAT_PENALTY=1.10

MAX_TOKENS=1024

#############################################
# API
#############################################

API_PORT=8000

#############################################
# Embedding API
#############################################

EMBEDDING_API_HOST=embedding-api

EMBEDDING_API_PORT=8010

#############################################
# HuggingFace Offline
#############################################

HF_HUB_OFFLINE=1

TRANSFORMERS_OFFLINE=1