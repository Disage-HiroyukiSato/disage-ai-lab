#############################################
# Project
#############################################

COMPOSE_PROJECT_NAME=disage-ai


#############################################
# Gateway
#############################################

# 開発・デモでは127.0.0.1を維持すること
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8088


#############################################
# Main LLM
#############################################

LLM_MODEL=qwen2.5-7b-instruct-q5_k_m.gguf

CONTEXT_SIZE=4096
THREAD_COUNT=8

# 使用GPUに合わせて調整
GPU_LAYER=999

TEMPERATURE=0.2
TOP_P=0.9
REPEAT_PENALTY=1.1


#############################################
# Query Rewriter LLM
#############################################

LLM_REWRITER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLM_REWRITER_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf

LLM_REWRITER_CONTEXT_SIZE=2048
LLM_REWRITER_GPU_LAYER=0


#############################################
# Docker Networks
#############################################

DOCKER_EDGE_NETWORK=disage-ai-edge
DOCKER_NETWORK=disage-ai-backend


#############################################
# Volumes
#############################################

CHROMA_VOLUME=disage-ai-chromadb
REDIS_VOLUME=disage-ai-redis
POSTGRES_VOLUME=disage-ai-postgres
BM25_VOLUME=disage-ai-bm25
SEARCH_LOG_VOLUME=disage-ai-search-log


#############################################
# Redis
#############################################

REDIS_MAXMEMORY=512mb